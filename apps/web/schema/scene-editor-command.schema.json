{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/scene-editor-command.schema.json",
  "title": "OpenSIMPV SceneEditorCommand v0.1",
  "description": "UI/session command envelope for the constrained 2-D editor. Commands are not canonical simulation inputs; committed results become a new Scene revision.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "command_type",
    "target_entity_ids",
    "parameters"
  ],
  "properties": {
    "schema_name": {
      "const": "SceneEditorCommand"
    },
    "schema_version": {
      "const": "0.1"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "command_type": {
      "enum": [
        "select",
        "multi_select",
        "move",
        "rotate",
        "set_reference_anchor",
        "scale",
        "copy",
        "array",
        "mirror",
        "delete",
        "undo",
        "redo",
        "draw_polygon",
        "draw_rectangle",
        "draw_line",
        "measure",
        "move_vertex",
        "insert_vertex",
        "delete_vertex",
        "move_edge",
        "edit_height",
        "edit_plane",
        "add_hole",
        "remove_hole",
        "edit_exact_dimension",
        "edit_exact_angle",
        "edit_elevation",
        "align",
        "distribute",
        "group",
        "ungroup",
        "lock",
        "unlock",
        "hide",
        "show"
      ]
    },
    "target_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "issued_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
