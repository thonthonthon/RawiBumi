{
  "name": "@rawibumi/web",
  "private": true,
  "version": "0.2.0-ui-a",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "tsc -b && vite build && vite build --mode report",
    "build:demo": "tsc -b && vite build --mode demo",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:tokens": "node scripts/build-tokens.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:openapi": "node scripts/gen-openapi.mjs",
    "check:generated": "node scripts/build-tokens.mjs --check && node scripts/gen-types.mjs --check && node scripts/third-party-notices.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "verify": "npm run check:generated && npm run check:boundaries && npm run typecheck && npm run test && npm run build && npm run quality",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:recovery": "playwright test -c playwright.recovery.config.ts",
    "test:scale": "playwright test -c playwright.scale.config.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "cmdk": "1.1.1",
    "echarts": "6.1.0",
    "flatbush": "4.6.2",
    "i18next": "26.5.3",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.0",
    "react-resizable-panels": "4.14.8",
    "three": "0.186.1",
    "tinykeys": "4.0.1",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "impeccable": "4.7.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
