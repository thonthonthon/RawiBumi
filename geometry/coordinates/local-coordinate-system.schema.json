{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/local-coordinate-system.schema.json",
  "title": "OpenSIMPV LocalCoordinateSystem v0.1",
  "description": "WGS84-anchored local metric engineering frame. EPSG:3857, when present, is map context only.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "coordinate_system_id",
    "site_id",
    "origin_latitude_deg",
    "origin_longitude_deg",
    "origin_elevation_m",
    "geographic_crs",
    "local_frame",
    "x_axis_definition",
    "y_axis_definition",
    "z_axis_definition",
    "rotation_from_true_north_deg",
    "rotation_convention"
  ],
  "properties": {
    "schema_name": {
      "const": "LocalCoordinateSystem"
    },
    "schema_version": {
      "const": "0.1"
    },
    "coordinate_system_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_latitude_deg": {
      "type": "number",
      "exclusiveMinimum": -90,
      "exclusiveMaximum": 90
    },
    "origin_longitude_deg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "origin_elevation_m": {
      "type": "number"
    },
    "geographic_crs": {
      "const": "EPSG:4326"
    },
    "local_frame": {
      "const": "rotated_enu"
    },
    "x_axis_definition": {
      "const": "East"
    },
    "y_axis_definition": {
      "const": "North"
    },
    "z_axis_definition": {
      "const": "Up"
    },
    "rotation_from_true_north_deg": {
      "type": "number",
      "minimum": -180,
      "exclusiveMaximum": 180
    },
    "rotation_convention": {
      "const": "positive_clockwise_local_y_from_true_north"
    },
    "map_projection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "crs",
            "role"
          ],
          "properties": {
            "crs": {
              "const": "EPSG:3857"
            },
            "role": {
              "const": "context_only"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
