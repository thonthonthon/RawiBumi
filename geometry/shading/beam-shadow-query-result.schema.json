{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/beam-shadow-query-result.schema.json",
  "title": "OpenSIMPV BeamShadowQueryResult v0.1",
  "description": "Deterministic Phase-5.3 direct-beam geometric visibility result for one receiver and one sun vector.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "solver_id",
    "solver_version",
    "compiled_geometry_hash",
    "receiver_id",
    "sun_vector_xyz",
    "sun_vector_convention",
    "projection_direction",
    "factor_convention",
    "status",
    "receiver_area_m2",
    "receiver_sun_dot",
    "receiver_planarity_max_error_m",
    "shaded_area_m2",
    "beam_visibility_factor",
    "beam_shaded_fraction",
    "self_shading_enabled",
    "contributing_occluder_ids",
    "projected_face_count",
    "clipped_shadow_polygon_count",
    "geometry_engine",
    "tolerances"
  ],
  "properties": {
    "schema_name": {
      "const": "BeamShadowQueryResult"
    },
    "schema_version": {
      "const": "0.1"
    },
    "solver_id": {
      "type": "string",
      "minLength": 1
    },
    "solver_version": {
      "type": "string",
      "minLength": 1
    },
    "compiled_geometry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiver_id": {
      "type": "string",
      "minLength": 1
    },
    "sun_vector_xyz": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "sun_vector_convention": {
      "const": "receiver_to_sun"
    },
    "projection_direction": {
      "const": "opposite_sun_vector"
    },
    "factor_convention": {
      "const": "visibility_one_clear_zero_blocked"
    },
    "status": {
      "enum": [
        "evaluated",
        "no_direct_beam_sun_below_horizon",
        "no_direct_beam_receiver_backside"
      ]
    },
    "receiver_area_m2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "receiver_sun_dot": {
      "type": "number"
    },
    "shaded_area_m2": {
      "type": "number",
      "minimum": 0
    },
    "beam_visibility_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "beam_shaded_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "self_shading_enabled": {
      "type": "boolean"
    },
    "contributing_occluder_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projected_face_count": {
      "type": "integer",
      "minimum": 0
    },
    "clipped_shadow_polygon_count": {
      "type": "integer",
      "minimum": 0
    },
    "tolerances": {
      "type": "object",
      "required": [
        "plane_distance_m",
        "parallel_dot",
        "area_m2",
        "horizon_z",
        "incidence_dot"
      ],
      "properties": {
        "plane_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parallel_dot": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "area_m2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "horizon_z": {
          "type": "number",
          "minimum": 0
        },
        "incidence_dot": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "geometry_engine": {
      "type": "object",
      "required": [
        "library",
        "shapely_version",
        "backend",
        "geos_version"
      ],
      "properties": {
        "library": {
          "const": "Shapely"
        },
        "shapely_version": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "const": "GEOS"
        },
        "geos_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "receiver_planarity_max_error_m": {
      "type": "number",
      "minimum": 0
    },
      "shadow_union_precision_fallback_events": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "receiver_id",
            "occluder_ids",
            "source_direction_xyz",
            "grid_size_m",
            "perimeter_m",
            "area_bound_m2"
          ],
          "properties": {
            "receiver_id": {
              "type": "string",
              "minLength": 1
            },
            "occluder_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_direction_xyz": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "grid_size_m": {
              "enum": [
                1e-10,
                1e-09,
                1e-08,
                1e-07,
                1e-06
              ]
            },
            "perimeter_m": {
              "type": "number",
              "minimum": 0
            },
            "area_bound_m2": {
              "type": "number",
              "minimum": 0
            },
            "timestamp": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "channel": {
              "enum": [
                "beam",
                "sky",
                "horizon",
                "ground"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "quality_flags": {
        "type": "array",
        "items": {
          "const": "shadow_union_precision_fallback"
        },
        "minItems": 1,
        "maxItems": 1
      }
  },
  "additionalProperties": false
}
