{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/directional-visibility-query-result.schema.json",
  "title": "OpenSIMPV DirectionalVisibilityQueryResult v0.1",
  "description": "Generic finite-receiver polygon-projection visibility for one arbitrary source direction. No global solar-horizon semantics are applied.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "solver_id",
    "solver_version",
    "compiled_geometry_hash",
    "receiver_id",
    "source_direction_xyz",
    "factor_convention",
    "receiver_area_m2",
    "receiver_source_dot",
    "receiver_planarity_max_error_m",
    "self_shading_enabled",
    "geometry_engine",
    "tolerances",
    "status",
    "shaded_area_m2",
    "visibility_factor",
    "shaded_fraction",
    "contributing_occluder_ids",
    "projected_face_count",
    "clipped_shadow_polygon_count"
  ],
  "properties": {
    "schema_name": {"const": "DirectionalVisibilityQueryResult"},
    "schema_version": {"const": "0.1"},
    "solver_id": {"type": "string", "minLength": 1},
    "solver_version": {"type": "string", "minLength": 1},
    "compiled_geometry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receiver_id": {"type": "string", "minLength": 1},
    "source_direction_xyz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "projection_direction": {"const": "opposite_source_direction"},
    "factor_convention": {"const": "visibility_one_clear_zero_blocked"},
    "receiver_area_m2": {"type": "number", "exclusiveMinimum": 0},
    "receiver_source_dot": {"type": "number"},
    "receiver_planarity_max_error_m": {"type": "number", "minimum": 0},
    "self_shading_enabled": {"type": "boolean"},
    "geometry_engine": {"type": "object"},
    "tolerances": {"type": "object"},
    "status": {
      "enum": [
        "evaluated",
        "source_behind_receiver"
      ]
    },
    "shaded_area_m2": {"type": "number", "minimum": 0},
    "visibility_factor": {"type": "number", "minimum": 0, "maximum": 1},
    "shaded_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "contributing_occluder_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "projected_face_count": {"type": "integer", "minimum": 0},
    "clipped_shadow_polygon_count": {"type": "integer", "minimum": 0},
      "shadow_union_precision_fallback_events": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "receiver_id",
            "occluder_ids",
            "source_direction_xyz",
            "grid_size_m",
            "perimeter_m",
            "area_bound_m2"
          ],
          "properties": {
            "receiver_id": {
              "type": "string",
              "minLength": 1
            },
            "occluder_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_direction_xyz": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "grid_size_m": {
              "enum": [
                1e-10,
                1e-09,
                1e-08,
                1e-07,
                1e-06
              ]
            },
            "perimeter_m": {
              "type": "number",
              "minimum": 0
            },
            "area_bound_m2": {
              "type": "number",
              "minimum": 0
            },
            "timestamp": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "channel": {
              "enum": [
                "beam",
                "sky",
                "horizon",
                "ground"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "quality_flags": {
        "type": "array",
        "items": {
          "const": "shadow_union_precision_fallback"
        },
        "minItems": 1,
        "maxItems": 1
      }
  },
  "additionalProperties": false
}
