{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "energy_summary_model_id",
    "energy_summary_model_version",
    "accounting_basis",
    "application",
    "sign_convention",
    "source_attribution_result_sha256",
    "source_identity",
    "scope_identity",
    "aggregation_policy",
    "observed_start",
    "observed_end",
    "observed_duration_seconds",
    "interval_audit",
    "periods"
  ],
  "properties": {
    "schema_name": {
      "const": "DetailedDCAttributionEnergySummary"
    },
    "schema_version": {
      "const": "0.1"
    },
    "energy_summary_model_id": {
      "const": "rawibumi.phase69b.dc_attribution_energy.v0.1"
    },
    "energy_summary_model_version": {
      "const": "0.1"
    },
    "accounting_basis": {
      "const": "detailed_selected_mppt_dc_before_residual_losses"
    },
    "application": {
      "const": "explanatory_only_never_applied_to_actual_ledger"
    },
    "sign_convention": {
      "const": "positive_reduction_negative_recovery"
    },
    "source_attribution_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_input_sha256",
        "attribution_model_id",
        "attribution_model_version",
        "source_numerical_result_sha256",
        "source_electrical_design_sha256",
        "source_module_input_hashes",
        "region_solvers",
        "sample_count",
        "numerical_policy"
      ],
      "properties": {
        "scientific_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attribution_model_id": {
          "const": "rawibumi.phase69b.detailed_dc_attribution.v0.1"
        },
        "attribution_model_version": {
          "const": "0.1"
        },
        "source_numerical_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_electrical_design_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_module_input_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "region_solvers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 101
        },
        "numerical_policy": {
          "type": "object"
        }
      }
    },
    "scope_identity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mppt_instance_id",
          "mppt_index",
          "module_ids",
          "string_ids",
          "tracker_model_id"
        ],
        "properties": {
          "mppt_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "mppt_index": {
            "type": "integer",
            "minimum": 1
          },
          "module_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "string_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "tracker_model_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aggregation_policy": {
      "const": {
        "integration": "power_w_times_explicit_duration_seconds_divided_by_3600",
        "period_assignment": "local_interval_start_entire_interval_no_boundary_proration",
        "partial_energy": "observed_available_intervals_only_no_extrapolation",
        "dark_coverage": "not_applicable_excluded_from_applicable_denominator",
        "scientific_values": "unrounded_signed_values_no_significance_suppression",
        "completeness_scope": "observed_simulated_intervals_only_not_full_calendar_period",
        "aggregation_scope": "validated_interval_ledger_across_applicable_mppt_scopes",
        "scope": "controlled_run_daily_monthly_no_annual_scale_claim"
      }
    },
    "observed_start": {
      "type": "string",
      "format": "date-time"
    },
    "observed_end": {
      "type": "string",
      "format": "date-time"
    },
    "observed_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "interval_audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/audit"
      }
    },
    "periods": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/period"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detailed DC attribution energy summary v0.1",
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "power_w",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "power_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "power_w": {
                "type": "number",
                "minimum": 0
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "power_w": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value_w",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "value_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value_w": {
                "type": "number"
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "value_w": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "telescope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "residual_w",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_applicable"
          ]
        },
        "residual_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "residual_w": {
                "type": "number"
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "residual_w": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bases",
        "channels",
        "telescope"
      ],
      "properties": {
        "bases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "U",
            "N",
            "B",
            "S",
            "C",
            "T"
          ],
          "properties": {
            "U": {
              "$ref": "#/$defs/basis"
            },
            "N": {
              "$ref": "#/$defs/basis"
            },
            "B": {
              "$ref": "#/$defs/basis"
            },
            "S": {
              "$ref": "#/$defs/basis"
            },
            "C": {
              "$ref": "#/$defs/basis"
            },
            "T": {
              "$ref": "#/$defs/basis"
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regional_mismatch",
            "bypass_interaction",
            "series_interaction",
            "parallel_interaction",
            "tracker_interaction",
            "total_detailed_dc_delta"
          ],
          "properties": {
            "regional_mismatch": {
              "$ref": "#/$defs/channel"
            },
            "bypass_interaction": {
              "$ref": "#/$defs/channel"
            },
            "series_interaction": {
              "$ref": "#/$defs/channel"
            },
            "parallel_interaction": {
              "$ref": "#/$defs/channel"
            },
            "tracker_interaction": {
              "$ref": "#/$defs/channel"
            },
            "total_detailed_dc_delta": {
              "$ref": "#/$defs/channel"
            }
          }
        },
        "telescope": {
          "$ref": "#/$defs/telescope"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "completeness",
        "applicable_interval_count",
        "available_interval_count",
        "unavailable_interval_count",
        "not_applicable_interval_count",
        "applicable_duration_seconds",
        "available_duration_seconds",
        "unavailable_duration_seconds",
        "not_applicable_duration_seconds",
        "availability_fraction",
        "observed_signed_energy_wh",
        "complete_signed_energy_wh",
        "unavailable_reason_codes",
        "unavailable_reasons"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "not_applicable"
          ]
        },
        "applicable_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "available_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "unavailable_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "not_applicable_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "availability_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "observed_signed_energy_wh": {
          "type": [
            "number",
            "null"
          ]
        },
        "complete_signed_energy_wh": {
          "type": [
            "number",
            "null"
          ]
        },
        "unavailable_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason_code",
              "interval_count",
              "duration_seconds"
            ],
            "properties": {
              "reason_code": {
                "type": "string",
                "minLength": 1
              },
              "interval_count": {
                "type": "integer",
                "minimum": 0
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "energy_telescope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking_bases",
        "blocking_channels",
        "common_available_interval_indices",
        "common_available_interval_count",
        "common_available_duration_seconds",
        "max_abs_interval_power_residual_w",
        "energy_residual_wh",
        "common_available_energy_residual_wh",
        "energy_absolute_tolerance_wh",
        "energy_relative_tolerance",
        "energy_allowed_residual_wh"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "not_applicable"
          ]
        },
        "blocking_bases": {
          "type": "array",
          "items": {
            "enum": [
              "U",
              "N",
              "B",
              "S",
              "C",
              "T"
            ]
          }
        },
        "blocking_channels": {
          "type": "array",
          "items": {
            "enum": [
              "regional_mismatch",
              "bypass_interaction",
              "series_interaction",
              "parallel_interaction",
              "tracker_interaction",
              "total_detailed_dc_delta"
            ]
          }
        },
        "common_available_interval_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "common_available_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "common_available_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_interval_power_residual_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "energy_residual_wh": {
          "type": [
            "number",
            "null"
          ]
        },
        "common_available_energy_residual_wh": {
          "type": [
            "number",
            "null"
          ]
        },
        "energy_absolute_tolerance_wh": {
          "type": "number",
          "minimum": 0
        },
        "energy_relative_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "energy_allowed_residual_wh": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "channel_energy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes",
        "signed_energy_wh"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "signed_energy_wh": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_start",
        "interval_end",
        "evaluation_time",
        "duration_seconds",
        "ledger",
        "channel_energy"
      ],
      "properties": {
        "interval_start": {
          "type": "string",
          "format": "date-time"
        },
        "interval_end": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation_time": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ledger": {
          "$ref": "#/$defs/ledger"
        },
        "channel_energy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regional_mismatch",
            "bypass_interaction",
            "series_interaction",
            "parallel_interaction",
            "tracker_interaction",
            "total_detailed_dc_delta"
          ],
          "properties": {
            "regional_mismatch": {
              "$ref": "#/$defs/channel_energy"
            },
            "bypass_interaction": {
              "$ref": "#/$defs/channel_energy"
            },
            "series_interaction": {
              "$ref": "#/$defs/channel_energy"
            },
            "parallel_interaction": {
              "$ref": "#/$defs/channel_energy"
            },
            "tracker_interaction": {
              "$ref": "#/$defs/channel_energy"
            },
            "total_detailed_dc_delta": {
              "$ref": "#/$defs/channel_energy"
            }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_kind",
        "period_key",
        "interval_indices",
        "observed_start",
        "observed_end",
        "interval_count",
        "duration_seconds",
        "bases",
        "channels",
        "telescope"
      ],
      "properties": {
        "period_kind": {
          "enum": [
            "run_total",
            "daily",
            "monthly"
          ]
        },
        "period_key": {
          "type": "string",
          "minLength": 1
        },
        "interval_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "observed_start": {
          "type": "string",
          "format": "date-time"
        },
        "observed_end": {
          "type": "string",
          "format": "date-time"
        },
        "interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "bases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "U",
            "N",
            "B",
            "S",
            "C",
            "T"
          ],
          "properties": {
            "U": {
              "$ref": "#/$defs/coverage"
            },
            "N": {
              "$ref": "#/$defs/coverage"
            },
            "B": {
              "$ref": "#/$defs/coverage"
            },
            "S": {
              "$ref": "#/$defs/coverage"
            },
            "C": {
              "$ref": "#/$defs/coverage"
            },
            "T": {
              "$ref": "#/$defs/coverage"
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regional_mismatch",
            "bypass_interaction",
            "series_interaction",
            "parallel_interaction",
            "tracker_interaction",
            "total_detailed_dc_delta"
          ],
          "properties": {
            "regional_mismatch": {
              "$ref": "#/$defs/coverage"
            },
            "bypass_interaction": {
              "$ref": "#/$defs/coverage"
            },
            "series_interaction": {
              "$ref": "#/$defs/coverage"
            },
            "parallel_interaction": {
              "$ref": "#/$defs/coverage"
            },
            "tracker_interaction": {
              "$ref": "#/$defs/coverage"
            },
            "total_detailed_dc_delta": {
              "$ref": "#/$defs/coverage"
            }
          }
        },
        "telescope": {
          "$ref": "#/$defs/energy_telescope"
        }
      }
