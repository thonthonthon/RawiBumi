{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/summary-result.schema.json",
  "title": "OpenSIMPV SummaryResult v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "simulation_run_id",
    "annual_energy_wh",
    "specific_yield_wh_per_wp",
    "performance_ratio",
    "capacity_factor",
    "monthly_energy",
    "loss_summary",
    "peak_dc_power_w",
    "peak_ac_power_w",
    "clipping_energy_wh",
    "shading_energy_loss_wh",
    "data_quality_summary",
    "period_start_time",
    "period_end_time",
    "period_duration_hours",
    "total_energy_wh",
    "capacity_factor_basis"
  ],
  "properties": {
    "schema_name": {
      "const": "SummaryResult"
    },
    "schema_version": {
      "const": "0.1"
    },
    "simulation_run_id": {
      "type": "string",
      "minLength": 1
    },
    "annual_energy_wh": {
      "type": [
        "number",
        "null"
      ],
      "description": "Total energy only when the executed period is a complete 8760/8784-hour year; null otherwise."
    },
    "specific_yield_wh_per_wp": {
      "type": "number"
    },
    "performance_ratio": {
      "type": "number"
    },
    "capacity_factor": {
      "type": "number"
    },
    "monthly_energy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "month",
          "energy_wh"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "energy_wh": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "loss_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "loss_type",
          "stage",
          "reference_energy_wh",
          "lost_energy_wh",
          "loss_fraction",
          "method",
          "notes"
        ],
        "properties": {
          "loss_type": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "reference_energy_wh": {
            "type": "number"
          },
          "lost_energy_wh": {
            "type": "number"
          },
          "loss_fraction": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "peak_dc_power_w": {
      "type": "number"
    },
    "peak_ac_power_w": {
      "type": "number"
    },
    "clipping_energy_wh": {
      "type": "number"
    },
    "shading_energy_loss_wh": {
      "type": [
        "number",
        "null"
      ]
    },
    "shading_energy_loss_basis": {
      "type": [
        "object",
        "null"
      ],
      "description": "Explicit counterfactual basis when geometric near-shading energy loss is quantified."
    },
    "data_quality_summary": {
      "type": "object"
    },
    "period_start_time": {
      "type": "string",
      "format": "date-time"
    },
    "period_end_time": {
      "type": "string",
      "format": "date-time"
    },
    "period_duration_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_energy_wh": {
      "type": "number"
    },
    "capacity_factor_basis": {
      "const": "installed_dc_nameplate_over_executed_period"
    },
    "execution_breakdown": {
      "$ref": "execution-breakdown.schema.json"
    },
    "resolved_loss_settings": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
