{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/reproducibility-manifest.schema.json",
  "title": "OpenSIMPV ReproducibilityManifest v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "project_revision_id",
    "scene_revision_id",
    "electrical_revision_id",
    "weather_revision_id",
    "component_revision_manifest",
    "engine_version",
    "model_manifest",
    "simulation_timestep_seconds",
    "timezone",
    "weather_transformations",
    "loss_models",
    "shading_configuration",
    "numerical_options",
    "input_hashes",
    "native_weather_resolution_seconds",
    "working_weather_resolution_seconds",
    "source_timestamp_convention",
    "representative_time_policy",
    "solar_evaluation_offset_minutes",
    "output_configuration",
    "result_logical_content_sha256",
    "result_file_sha256"
  ],
  "properties": {
    "detailed_execution_identity": {"$ref": "detailed-execution-identity.schema.json"},
    "schema_name": {
      "const": "ReproducibilityManifest"
    },
    "schema_version": {
      "const": "0.1"
    },
    "project_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "electrical_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "weather_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "component_revision_manifest": {
      "type": "object"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "model_manifest": {
      "type": "object"
    },
    "simulation_timestep_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "weather_transformations": {
      "type": "array"
    },
    "loss_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shading_configuration": {
      "type": "object"
    },
    "numerical_options": {
      "type": "object"
    },
    "input_hashes": {
      "type": "object",
      "required": [
        "project_revision_sha256",
        "simulation_configuration_sha256",
        "scene_revision_sha256",
        "electrical_revision_sha256",
        "weather_dataset_sha256",
        "weather_series_logical_sha256",
        "component_manifest_sha256",
        "combined_input_sha256",
        "engine_version_sha256"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "native_weather_resolution_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "working_weather_resolution_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "source_timestamp_convention": {
      "type": "string",
      "minLength": 1
    },
    "representative_time_policy": {
      "type": "string",
      "minLength": 1
    },
    "solar_evaluation_offset_minutes": {
      "type": "number"
    },
    "output_configuration": {
      "type": "object"
    },
    "result_logical_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "design_validation_report_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "design_validation_report_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "design_validation_rule_set_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "shading_receiver_factor_reference": {
      "anyOf": [
        {
          "$ref": "result-dataset-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "shading_result_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "shading_result_payload_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "shading_physical_result_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
