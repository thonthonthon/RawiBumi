{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/run-package-manifest.schema.json",
  "title": "OpenSIMPV RunPackageManifest v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "simulation_run_id",
    "package_state",
    "completion_rule",
    "recovery_rule",
    "artifact_count",
    "artifacts",
    "manifest_payload_sha256"
  ],
  "properties": {
    "schema_name": {"const": "RunPackageManifest"},
    "schema_version": {"const": "0.1"},
    "simulation_run_id": {"type": "string", "minLength": 1},
    "package_state": {"const": "complete"},
    "completion_rule": {"type": "string", "minLength": 1},
    "recovery_rule": {"type": "string", "minLength": 1},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "role", "byte_size", "sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "manifest_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
