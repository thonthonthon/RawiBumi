{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/detailed-mppt-backend-result.schema.json",
  "title": "DetailedMPPTBackendResult v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "scientific_input_sha256",
    "temporal_metadata",
    "temperature_metadata",
    "intervals",
    "weather_qc",
    "numerical_policy",
    "downstream_continuation",
    "model_resolution_metadata"
  ],
  "properties": {
    "schema_name": {
      "const": "DetailedMPPTBackendResult"
    },
    "schema_version": {
      "const": "0.1"
    },
    "scientific_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "temporal_metadata": {
      "type": "object"
    },
    "temperature_metadata": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object"
      }
    },
    "weather_qc": {
      "type": "object"
    },
    "numerical_policy": {
      "type": "object"
    },
    "downstream_continuation": {
      "const": "unavailable_phase69a_mppt_boundary"
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interval"
      }
    },
    "model_resolution_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "loss_circuit_references": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_start",
        "interval_end",
        "evaluation_time",
        "duration_seconds",
        "modules",
        "strings",
        "mppts"
      ],
      "properties": {
        "interval_start": {
          "type": "string",
          "format": "date-time"
        },
        "interval_end": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation_time": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "modules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object"
          }
        },
        "strings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object"
          }
        },
        "mppts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mppt"
          }
        }
      }
    },
    "mppt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mppt_instance_id",
        "mppt_index",
        "selected_operating_point",
        "tracker_model_id",
        "constraint_flags",
        "tracker_state",
        "combined_curve",
        "combined_state"
      ],
      "properties": {
        "mppt_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "mppt_index": {
          "type": "integer",
          "minimum": 1
        },
        "selected_operating_point": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "voltage_v",
            "current_a",
            "power_w"
          ],
          "properties": {
            "voltage_v": {
              "type": "number",
              "minimum": 0
            },
            "current_a": {
              "type": "number",
              "minimum": 0
            },
            "power_w": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "tracker_model_id": {
          "type": "string",
          "minLength": 1
        },
        "constraint_flags": {
          "type": "object"
        },
        "tracker_state": {
          "type": [
            "object",
            "null"
          ]
        },
        "combined_curve": {
          "type": [
            "object",
            "null"
          ]
        },
        "combined_state": {
          "type": "object"
        },
        "availability": {
          "const": "inactive_dark"
        },
        "inactive_reason": {
          "const": "no_photovoltaic_operating_point"
        },
        "power_w": {
          "const": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "availability"
            ],
            "properties": {
              "availability": {
                "const": "inactive_dark"
              }
            }
          },
          "then": {
            "required": [
              "power_w",
              "inactive_reason"
            ],
            "properties": {
              "selected_operating_point": {
                "type": "null"
              },
              "tracker_state": {
                "type": "null"
              },
              "combined_curve": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "selected_operating_point": {
                "type": "object"
              },
              "tracker_state": {
                "type": "object"
              },
              "combined_curve": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
