{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/iv-reference-dataset.schema.json",
  "title": "OpenSIMPV IVReferenceDataset v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "dataset_id",
    "revision_id",
    "name",
    "source_kind",
    "points"
  ],
  "properties": {
    "schema_name": {"const": "IVReferenceDataset"},
    "schema_version": {"const": "0.1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source_id": {"type": ["string", "null"]},
    "source_kind": {
      "enum": [
        "iec61853_matrix",
        "laboratory_iv",
        "field_iv",
        "datasheet_matrix",
        "synthetic_reference",
        "other"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_file"}
    },
    "provenance": {
      "type": ["object", "null"],
      "properties": {
        "source_group_id": {"type": ["string", "null"]},
        "derived_from_source_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "original_repository": {"type": ["string", "null"]},
        "original_revision": {"type": ["string", "null"]},
        "measurement_reference_url": {"type": ["string", "null"]},
        "redistribution_license_spdx": {"type": ["string", "null"]},
        "redistribution_license_url": {"type": ["string", "null"]},
        "redistribution_note": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "ingestion": {
      "type": ["object", "null"],
      "properties": {
        "parser_name": {"type": ["string", "null"]},
        "parser_version": {"type": ["string", "null"]},
        "encoding": {"type": ["string", "null"]},
        "source_record_count": {"type": ["integer", "null"], "minimum": 0},
        "selected_source_indices": {
          "type": ["array", "null"],
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "transformations": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "module_identity": {
      "type": ["object", "null"],
      "properties": {
        "manufacturer": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "serial_number": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "measurement_context": {
      "type": ["object", "null"],
      "properties": {
        "irradiance_quantity": {
          "enum": ["effective_irradiance", "plane_of_array_irradiance", "unknown", null]
        },
        "spectral_correction_applied": {"type": ["boolean", "null"]},
        "temperature_quantity": {
          "enum": ["cell_temperature", "module_temperature", "unknown", null]
        },
        "uncertainty_basis": {
          "enum": ["standard", "expanded", "absolute_bound", "unknown", null]
        },
        "laboratory": {"type": ["string", "null"]},
        "standard_or_method": {"type": ["string", "null"]},
        "measurement_date": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference_point"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "source_file": {
      "type": "object",
      "required": ["file_id", "filename", "byte_size", "sha256"],
      "properties": {
        "file_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "media_type": {"type": ["string", "null"]},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_url": {"type": ["string", "null"]},
        "source_git_blob_sha": {"type": ["string", "null"]},
        "license_spdx": {"type": ["string", "null"]},
        "license_url": {"type": ["string", "null"]},
        "attribution": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["isc_a", "voc_v", "imp_a", "vmp_v", "pmp_w"],
      "properties": {
        "isc_a": {"type": "number"},
        "voc_v": {"type": "number"},
        "imp_a": {"type": "number"},
        "vmp_v": {"type": "number"},
        "pmp_w": {"type": "number"}
      },
      "additionalProperties": false
    },
    "iv_sample": {
      "type": "object",
      "required": ["voltage_v", "current_a"],
      "properties": {
        "voltage_v": {"type": "number"},
        "current_a": {"type": "number"},
        "voltage_uncertainty_v": {"type": ["number", "null"], "minimum": 0},
        "current_uncertainty_a": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "irradiance_w_m2": {"type": ["number", "null"], "minimum": 0},
        "cell_temperature_c": {"type": ["number", "null"], "minimum": 0},
        "isc_a": {"type": ["number", "null"], "minimum": 0},
        "voc_v": {"type": ["number", "null"], "minimum": 0},
        "imp_a": {"type": ["number", "null"], "minimum": 0},
        "vmp_v": {"type": ["number", "null"], "minimum": 0},
        "pmp_w": {"type": ["number", "null"], "minimum": 0},
        "confidence_fraction": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "coverage_factor": {"type": ["number", "null"], "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "reference_point": {
      "type": "object",
      "required": [
        "point_id",
        "effective_irradiance_w_m2",
        "cell_temperature_c",
        "summary"
      ],
      "properties": {
        "point_id": {"type": "string", "minLength": 1},
        "source_index": {"type": ["integer", "null"], "minimum": 0},
        "source_sample_count": {"type": ["integer", "null"], "minimum": 1},
        "effective_irradiance_w_m2": {"type": "number", "exclusiveMinimum": 0},
        "plane_of_array_irradiance_w_m2": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "cell_temperature_c": {"type": "number"},
        "summary": {"$ref": "#/$defs/summary"},
        "iv_curve": {
          "type": ["array", "null"],
          "minItems": 3,
          "items": {"$ref": "#/$defs/iv_sample"}
        },
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "source_point_reference": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
