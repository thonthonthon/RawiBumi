{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/field-mapping-ledger.schema.json",
  "title": "OpenSIMPV PAN/OND Field Mapping Ledger v0.1",
  "type": "object",
  "required": ["schema_version", "format", "rules"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "format": {"enum": ["pan", "ond"]},
    "notes": {"type": ["string", "null"]},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_path", "canonical_field", "source_unit", "canonical_unit",
          "conversion_rule", "semantic_description", "required_for_model",
          "confidence", "auto_map", "evidence"
        ],
        "properties": {
          "source_path": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "canonical_field": {"type": ["string", "null"]},
          "source_unit": {"type": ["string", "null"]},
          "canonical_unit": {"type": ["string", "null"]},
          "conversion_rule": {
            "enum": [
              "string", "float", "abs_float", "int", "kw_to_w",
              "ma_to_a", "mv_to_v", "percent_to_fraction", "loss_percent_to_fraction",
              "csv_float_list", "power_pair_w", "angle_modifier_pair",
              "mono_tri_to_phase", "pvsyst_technology_code", "identity_unmapped"
            ]
          },
          "semantic_description": {"type": "string"},
          "required_for_model": {"type": "boolean"},
          "confidence": {
            "enum": ["confirmed", "documented", "empirically_verified", "inferred", "unknown"]
          },
          "auto_map": {"type": "boolean"},
          "scope": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]},
          "first_seen_format_version": {"type": ["string", "number", "null"]},
          "last_verified_format_version": {"type": ["string", "number", "null"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "url"],
              "properties": {
                "kind": {"enum": ["official_documentation", "reference_repository", "reference_fixture", "datasheet", "test"]},
                "url": {"type": "string"},
                "note": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
