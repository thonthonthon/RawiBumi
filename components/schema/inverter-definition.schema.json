{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/inverter-definition.schema.json",
  "title": "OpenSIMPV InverterDefinition v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "inverter_definition_id",
    "revision_id",
    "manufacturer",
    "model",
    "phase_configuration",
    "verification_state",
    "dc_limits",
    "ac_limits"
  ],
  "anyOf": [
    {
      "required": [
        "mppts"
      ]
    },
    {
      "required": [
        "mppt_template"
      ]
    }
  ],
  "properties": {
    "schema_name": {
      "const": "InverterDefinition"
    },
    "schema_version": {
      "const": "0.1"
    },
    "inverter_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "inverter_type": {
      "enum": [
        "string",
        "central",
        "microinverter",
        "hybrid",
        "bidirectional",
        "other"
      ]
    },
    "phase_configuration": {
      "enum": [
        "single_phase",
        "three_phase",
        "other"
      ]
    },
    "verification_state": {
      "enum": [
        "unverified",
        "source_attached",
        "auto_validated",
        "reviewed",
        "manufacturer_verified"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dc_limits": {
      "type": "object",
      "required": [
        "max_dc_voltage_v"
      ],
      "properties": {
        "max_dc_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_dc_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_dc_power_w": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_dc_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_dc_short_circuit_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "startup_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "shutdown_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "min_voltage_for_nominal_power_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "ac_limits": {
      "type": "object",
      "required": [
        "nominal_ac_power_w",
        "nominal_ac_voltage_v"
      ],
      "properties": {
        "nominal_ac_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_ac_power_w": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "nominal_ac_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Nominal AC frequency when established by the source or user. Optional because OND/source candidates may not provide a verified frequency."
        },
        "max_ac_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "nominal_ac_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_ac_apparent_power_va": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "mppt_template": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "count",
        "min_operating_voltage_v",
        "max_operating_voltage_v"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "min_operating_voltage_v": {
          "type": "number",
          "minimum": 0
        },
        "max_operating_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_operating_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_short_circuit_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "total_input_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "input_count_per_mppt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "independent_inputs": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "mppts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mppt_index",
          "min_operating_voltage_v",
          "max_operating_voltage_v",
          "max_operating_current_a",
          "max_short_circuit_current_a",
          "input_count"
        ],
        "properties": {
          "mppt_index": {
            "type": "integer",
            "minimum": 1
          },
          "min_operating_voltage_v": {
            "type": "number",
            "minimum": 0
          },
          "max_operating_voltage_v": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "nominal_voltage_v": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "max_operating_current_a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_short_circuit_current_a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "input_count": {
            "type": "integer",
            "minimum": 1
          },
          "independent_inputs": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "operating_thresholds": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "minimum_input_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "startup_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "shutdown_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "standby_loss_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "night_loss_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "efficiency_model": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "model_type": {
          "enum": [
            "constant",
            "one_dimensional_curve",
            "voltage_dependent_curves",
            "sandia",
            "pvwatts",
            "custom"
          ]
        },
        "curves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dc_voltage_v",
              "points"
            ],
            "properties": {
              "dc_voltage_v": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "dc_power_w",
                    "ac_power_w",
                    "efficiency_fraction"
                  ],
                  "properties": {
                    "dc_power_w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "ac_power_w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "efficiency_fraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "startup_loss_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "standby_loss_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "night_loss_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reference_metrics": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "max_efficiency_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "european_efficiency_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "cec_efficiency_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "capability_flags": {
      "type": "object",
      "properties": {
        "basic_design_ready": {
          "type": "boolean"
        },
        "mppt_design_ready": {
          "type": "boolean"
        },
        "basic_yield_ready": {
          "type": "boolean"
        },
        "detailed_efficiency_ready": {
          "type": "boolean"
        },
        "derating_ready": {
          "type": "boolean"
        },
        "mppt_voltage_ready": {
          "type": "boolean"
        },
        "mppt_current_limit_ready": {
          "type": "boolean"
        },
        "array_sizing_ready": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "array_sizing_limits": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "nominal_pv_array_power_w": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_pv_array_power_w": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_pv_current_a": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "temperature_derating_model": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "temperature_basis": {
          "enum": [
            "ambient",
            "inverter_internal",
            "ambient_plus_offset",
            "unknown",
            null
          ]
        },
        "max_power_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "nominal_power_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "limit1_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "limit1_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "absolute_limit_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
