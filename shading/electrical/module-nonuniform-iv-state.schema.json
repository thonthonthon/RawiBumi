{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimpv.org/schema/module-nonuniform-iv-state.schema.json",
  "title": "OpenSIMPV ModuleNonuniformIVState v0.1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "contract_version",
    "state_id",
    "source_module_instance_id",
    "source_module_topology_revision_id",
    "source_electrical_region_map_id",
    "source_electrical_region_map_hash",
    "source_local_irradiance_state_id",
    "source_local_irradiance_state_hash",
    "parameterization_id",
    "parameterization_payload_sha256",
    "module_curve_id",
    "isc_a",
    "voc_v",
    "current_samples",
    "scientific_input_sha256",
    "state_payload_sha256"
  ],
  "properties": {
    "schema_name": {
      "const": "ModuleNonuniformIVState"
    },
    "schema_version": {
      "const": "0.1"
    },
    "contract_version": {
      "const": "0.1"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "source_module_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "source_module_topology_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_electrical_region_map_id": {
      "type": "string",
      "minLength": 1
    },
    "source_electrical_region_map_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_local_irradiance_state_id": {
      "type": "string",
      "minLength": 1
    },
    "source_local_irradiance_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameterization_id": {
      "type": "string",
      "minLength": 1
    },
    "parameterization_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "module_curve_id": {
      "type": "string",
      "minLength": 1
    },
    "isc_a": {
      "type": "number",
      "minimum": 0
    },
    "voc_v": {
      "type": "number",
      "minimum": 0
    },
    "current_samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/current_sample"
      }
    },
    "scientific_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "branch_id",
        "current_a",
        "voltage_v"
      ],
      "properties": {
        "branch_id": {
          "type": "string"
        },
        "current_a": {
          "type": "number"
        },
        "voltage_v": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "substring": {
      "type": "object",
      "required": [
        "substring_id",
        "series_order",
        "terminal_voltage_v",
        "unbypassed_voltage_v",
        "unbypassed_solution_available",
        "bypass_device_id",
        "bypass_active",
        "bypass_current_a",
        "transition_margin_v",
        "terminal_branch_states"
      ],
      "properties": {
        "substring_id": {
          "type": "string",
          "minLength": 1
        },
        "series_order": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_voltage_v": {
          "type": "number"
        },
        "unbypassed_voltage_v": {
          "type": [
            "number",
            "null"
          ]
        },
        "bypass_device_id": {
          "type": "string",
          "minLength": 1
        },
        "bypass_active": {
          "type": "boolean"
        },
        "bypass_current_a": {
          "type": "number",
          "minimum": 0
        },
        "transition_margin_v": {
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_branch_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "unbypassed_solution_available": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "current_sample": {
      "type": "object",
      "required": [
        "current_a",
        "module_voltage_v",
        "module_power_w",
        "substrings"
      ],
      "properties": {
        "current_a": {
          "type": "number",
          "minimum": 0
        },
        "module_voltage_v": {
          "type": "number"
        },
        "module_power_w": {
          "type": "number"
        },
        "substrings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/substring"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
